# Salin file ini menjadi ".env" lalu isi nilai di bawah.
# JANGAN commit file ".env" (sudah masuk .gitignore) karena berisi API key.

# API key gratis dari https://home.openweathermap.org/users/sign_up
# (aktivasi butuh beberapa menit setelah daftar)
OPENWEATHER_API_KEY= d3db6282242ecdb51ec86cdeb1ff7b39

# Database. Default (kosongkan) = SQLite lokal di data/pm25.db
# Untuk deployment cloud, isi dengan connection string Postgres, contoh:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Interval ingestion otomatis (menit) untuk scripts/run_scheduler.py
INGEST_INTERVAL_MINUTES=60

# TTL cache dashboard Streamlit (detik) sebelum menarik ulang dari database
CACHE_TTL_SECONDS=300
